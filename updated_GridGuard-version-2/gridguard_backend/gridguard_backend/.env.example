# GridGuard local configuration template
#
# Copy this file to .env, replace the placeholder values, then restart the
# FastAPI backend. Never commit the real .env file.

# Generate a long random value before presenting the project publicly.
GRIDGUARD_SECRET_KEY=replace-with-a-long-random-secret

# Gmail SMTP configuration. Use a Google App Password, not your normal Gmail
# password: https://myaccount.google.com/apppasswords
GRIDGUARD_SMTP_HOST=smtp.gmail.com
GRIDGUARD_SMTP_PORT=587
GRIDGUARD_SMTP_USER=your-email@gmail.com
GRIDGUARD_SMTP_PASSWORD=your-app-password
GRIDGUARD_SMTP_FROM=your-email@gmail.com

# Optional: route every alert to one monitored utility/theft-desk mailbox.
# If omitted, active administrator email addresses receive alerts.
# GRIDGUARD_ALERT_RECIPIENT=theft-desk@example.com
